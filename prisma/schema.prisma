generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum WebhookState {
  RECEIVED
  PROCESSED
  FAILED
}

enum CatalogResourceType {
  PRODUCT
  COLLECTION
}

model CatalogWebhook {
  id                String       @id @default(cuid())
  webhookId         String       @unique
  shop              String
  topic             String
  resourceType      CatalogResourceType
  payload           String
  payloadHash       String
  resourceId        String?
  occurredAt        DateTime?
  state             WebhookState @default(RECEIVED)
  error             String?
  receivedAt        DateTime     @default(now())
  processedAt       DateTime?
  snapshot          CatalogSnapshot?

  @@index([shop, receivedAt])
  @@index([shop, resourceType, receivedAt])
}

model CatalogSnapshot {
  id              String              @id @default(cuid())
  shop            String
  resourceType    CatalogResourceType
  resourceId      String
  sourceWebhookId String              @unique
  sourceTopic     String
  state           String
  stateHash       String
  isDeleted       Boolean
  occurredAt      DateTime?
  receivedAt      DateTime
  createdAt       DateTime            @default(now())
  sourceWebhook   CatalogWebhook      @relation(fields: [sourceWebhookId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shop, resourceType, resourceId, receivedAt])
  @@index([shop, receivedAt])
  @@index([shop, resourceType, receivedAt])
  @@index([shop, sourceTopic, receivedAt])
  @@index([shop, isDeleted, receivedAt])
}
